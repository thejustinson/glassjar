# ─── GlassJar Environment Variables Template ───────────────────────────────

# Cookie Chain Network Configuration (Independent SVM Cluster)
NEXT_PUBLIC_COOKIE_RPC=https://rpc.cookiescan.io
NEXT_PUBLIC_COOKIE_WSS=wss://wss.cookiescan.io
NEXT_PUBLIC_COOKIE_DAS_API=https://api.cookiescan.io
NEXT_PUBLIC_COOKIE_EXPLORER=https://cookiescan.io

# Solana Mainnet RPC (Used for Zap Bridge & Hyperlane Reads)
NEXT_PUBLIC_SOLANA_RPC=https://api.mainnet-beta.solana.com
SOLANA_MAINNET_RPC=https://api.mainnet-beta.solana.com

# Supabase (Off-chain Cache: Watchlists, Preferences, Tx History Log)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional App URL for server-side proxies
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Admin & Faucet Configuration (Optional / Self-Hosted)
ADMIN_PASSWORD=your_secure_admin_password
FAUCET_PAYER_PRIVATE_KEY=your_faucet_keypair_base58
FAUCET_WHITELIST_ADDRESS=
